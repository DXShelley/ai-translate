{
  "name": "temp-translate",
  "version": "7.0.1",
  "description": "一个浏览器扩展原型，用于在网页中进行本地或 OpenAI 兼容模型翻译。扩展重点支持划词、句子、段落三种粒度，并在同一弹框内复用上下文和已返回结果，减少重复请求。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:firefox": "node scripts/build.js firefox",
    "build:chrome": "node scripts/build.js chrome",
    "build:edge": "node scripts/build.js edge",
    "release:all": "node scripts/release-all.js",
    "release:obsidian": "node scripts/release-all.js --obsidian",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "archiver": "^8.0.0",
    "clean-css-cli": "^5.6.3",
    "obsidian": "1.12.3",
    "terser": "^5.46.2"
  }
}
